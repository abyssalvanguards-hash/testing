# Core bot credentials (set on the bot host)
# DISCORD_TOKEN=
# GEMINI_API_KEY=

# Optional remote web panel integration. Leave PANEL_ENABLED=false to disable it.
# The bot makes outbound HTTPS requests only when enabled; no inbound bot port is needed.
PANEL_ENABLED=false
# Base URL of your separately hosted panel API, e.g. https://panel.example.com
PANEL_API_URL=
# Long random shared secret. Set the same value on the panel host and bot host.
PANEL_SHARED_SECRET=
# Poll interval in seconds. Higher values reduce background load (minimum 15).
PANEL_POLL_INTERVAL=45
